{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "figcraft-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "FigCraftContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FIGCRAFT_CONTAINER",
        "class_name": "FigCraftContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FigCraftContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
