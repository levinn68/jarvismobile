# ==============================================================================
# ALL ACCESS J.A.R.V.I.S. — ENVIRONMENT CONFIGURATION TEMPLATE (BATCH 8.7)
# ==============================================================================
# Never commit real production API keys, tokens, or signing passwords into Git.
# Separate development, testing, staging, and production values strictly.

# ------------------------------------------------------------------------------
# 1. JARVIS Android Client & Release Signing Configuration (gradle.properties / env)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
JARVIS_WORKER_URL=https://jarvis-api.YOUR_SUBDOMAIN.workers.dev
JARVIS_API_BASE_URL=https://jarvis-api.YOUR_SUBDOMAIN.workers.dev

# Android Release Signing (CI / Local Release Build Only — never commit keystore)
JARVIS_KEYSTORE_FILE=/secure/path/to/jarvis-release.jks
KEYSTORE_PASSWORD=replace-with-keystore-password
KEY_ALIAS=jarvis-release-key
KEY_PASSWORD=replace-with-key-password

# ------------------------------------------------------------------------------
# 2. Supabase Local / CLI OAuth Configuration (supabase/config.toml)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# ------------------------------------------------------------------------------
# 3. Cloudflare Worker Secrets (Set via `wrangler secret put <NAME>`)
# ------------------------------------------------------------------------------
DEVICE_TOKEN_SECRET=replace-with-a-cryptographically-random-64-char-secret
DEVICE_ENROLLMENT_SECRET=replace-with-a-cryptographically-random-bootstrap-secret
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Optional Server-Managed AI Council Fallback Keys (User keys are managed via /v1/ai-accounts)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=
ANTHROPIC_API_KEY_3=
DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Voice (Fish Audio) & Web Search (SerpApi) Integrations
FISH_API_KEY=
FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe
SERPAPI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Cloudflare Worker Runtime & Environment Separation (wrangler.toml [vars])
# ------------------------------------------------------------------------------
# Valid values: production | staging | development | test
# Note: Mock providers are strictly blocked when JARVIS_ENV=production.
JARVIS_ENV=production
JARVIS_ALLOW_MOCK_PROVIDERS=false
JARVIS_ALLOWED_ORIGINS=https://app.jarvis.internal,http://localhost:3000
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_SECONDS=60
DEVICE_COMMAND_TTL_SECONDS=600
DEVICE_TOKEN_TTL_DAYS=90
ACCOUNT_TOKEN_TTL_DAYS=180
SUPABASE_AUTH_TIMEOUT_MS=8000
LOG_LEVEL=info
