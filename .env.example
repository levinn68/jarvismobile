# ==============================================================================
# ALL ACCESS J.A.R.V.I.S. — Environment Configuration Template (B8.1.1 R1)
# Copy to `.env` for local development. NEVER commit real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Android / Client Build Configuration (GitHub Actions Secrets)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
JARVIS_ALLOWED_ORIGINS=https://your-frontend.example
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
JARVIS_WORKER_URL=https://jarvis-api.YOUR_SUBDOMAIN.workers.dev
JARVIS_API_BASE_URL=https://jarvis-api.YOUR_SUBDOMAIN.workers.dev

# ------------------------------------------------------------------------------
# 2. Supabase Auth Provider Configuration (Dashboard -> Authentication -> Google)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# ------------------------------------------------------------------------------
# 3. Cloudflare Worker Secrets (Set via `wrangler secret put <NAME>`)
# ------------------------------------------------------------------------------
DEVICE_TOKEN_SECRET=replace-with-a-cryptographically-random-64-char-secret
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-dedicated-random-64-char-secret
AI_CREDENTIAL_KEY_ID=k2_primary_202611
# Optional during key rotation / legacy v1 credential migration:
AI_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
LEGACY_AI_CREDENTIAL_ENCRYPTION_KEY=
DEVICE_ENROLLMENT_SECRET=replace-with-a-cryptographically-random-bootstrap-secret
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Built-in Multi-Provider AI Keys (up to 3 rotation slots per provider)
GEMINI_API_KEY_1=
DEEPSEEK_API_KEY_1=
GROQ_API_KEY_1=
OPENAI_API_KEY_1=
OPENROUTER_API_KEY_1=
ANTHROPIC_API_KEY_1=

# Optional Voice & Visual Search Keys
FISH_API_KEY=
SERPAPI_API_KEY=
